# pacman's systemd hooks create the puzuz user and group (sysusers.d), the directories
# (tmpfiles.d) and reload systemd. As usual on Arch, nothing is enabled or restarted here.

post_install() {
  cat <<'EOF'
==> Start puzuz:
      sudo systemctl enable --now puzuz-helper.service puzuz.service
      puzuz doctor
==> Checkpoint and restore need CRIU 4.2 or newer: sudo pacman -S criu
    GPU jobs need NVIDIA's cuda-checkpoint, see
    https://github.com/kaito4681/puzuz/blob/main/docs/install.md#cuda-checkpoint
==> Make someone an administrator: sudo usermod -aG puzuz-admin <user>
EOF
}

post_upgrade() {
  cat <<'EOF'
==> Restart puzuz to run the new version (running jobs keep running):
      sudo systemctl restart puzuz-helper.service puzuz.service
    The puzuz command and the daemon must be the same version.
EOF
}

post_remove() {
  cat <<'EOF'
==> If the services were enabled, stop them and remove their links:
      sudo systemctl disable --now puzuz.service puzuz-helper.service
    Jobs still running in puzuz-job-* units keep running until stopped
    (sudo systemctl stop 'puzuz-job-*').
==> /etc/puzuz (if changed) and /var/lib/puzuz (state, logs, checkpoint images) are kept.
    Delete them by hand to remove all data.
EOF
}
