#!/bin/sh
# Before the gpueue package is installed: refuse to install next to an
# installation made by `gpueue service install` (install.sh, `gpueue update`).
# Its units in /etc/systemd/system would override the package's units in
# /usr/lib/systemd/system, so the package's binaries would never run.
#
# Arguments: deb `install [<old-version>]` / `upgrade <old-version>` /
# `abort-upgrade <new-version>`; rpm %pre `1` (install) / `2` (upgrade).
set -e

# Must equal service::MARKER (checked by a unit test in crates/gpueue).
MARKER='# Installed by `gpueue service install`; re-running it overwrites this file.'

case "$1" in
install | 1)
    for unit in /etc/systemd/system/gpueue.service /etc/systemd/system/gpueue-helper.service; do
        if [ -f "$unit" ] && [ "$(head -n 1 "$unit")" = "$MARKER" ]; then
            echo "gpueue is already installed with \`gpueue service install\` (install.sh) ($unit)." >&2
            echo "Remove that installation first (running jobs, /etc/gpueue and /var/lib/gpueue are kept):" >&2
            echo "  sudo gpueue uninstall   (a gpueue without that command: sudo bash install.sh --uninstall)" >&2
            echo "then install this package again." >&2
            exit 1
        fi
    done
    ;;
esac

exit 0
