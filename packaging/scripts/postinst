#!/bin/sh
# After the gpueue package is installed or upgraded: create the user and the
# directories, then enable and start the services (first installation) or
# restart them (upgrade). Running jobs are transient units of their own
# (gpueue-job-<id>.service) and keep running while the services restart.
#
# Arguments: deb `configure [<last-configured-version>]` (empty on the first
# installation) / `abort-remove` / `abort-deconfigure ...` / `abort-upgrade
# <new-version>`; rpm %post `1` (install) / `2` (upgrade).
#
# Without systemd as PID 1 (a container or a chroot) nothing is started; the
# services are only enabled, so they start when the system boots.
# shellcheck disable=SC2086 # $UNITS is split into the unit names on purpose.
set -e

UNITS="gpueue-helper.service gpueue.service"
# Left by prerm when the package was removed but not purged: dpkg then still
# passes the old version to `configure`, but the services were disabled.
REMOVED_MARKER=/var/lib/gpueue/package-removed

systemd_running() {
    [ -d /run/systemd/system ]
}

# Whether $1, what it resolves to and every directory above that are owned by
# root and not group- or world-writable, as the helper requires of a program
# it runs as root: nothing else is run here either.
root_owned() {
    p=$(readlink -f -- "$1") || return 1
    while :; do
        [ -n "$(find "$p" -maxdepth 0 -user 0 ! -perm /022 2>/dev/null)" ] || return 1
        [ "$p" = / ] && return 0
        p=$(dirname -- "$p")
    done
}

# Warns when the CRIU the helper would use is missing or older than 4.2: jobs
# run without it, but every checkpoint is refused. Never fails the install.
check_criu() {
    criu=$(sed -n 's/^[[:space:]]*criu_path[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/gpueue/config.toml 2>/dev/null | tail -n 1)
    [ -n "$criu" ] || criu=criu
    case "$criu" in
    */*) [ -x "$criu" ] || criu= ;;
    *)
        name=$criu
        criu=
        # systemd's PATH for services, which the helper searches.
        for dir in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
            if [ -f "$dir/$name" ] && [ -x "$dir/$name" ]; then
                criu=$dir/$name
                break
            fi
        done
        ;;
    esac
    if [ -z "$criu" ]; then
        found="not found"
    elif ! root_owned "$criu"; then
        echo "gpueue: warning: $criu is not owned by root (or is writable by others), so the helper will not run it; see \`gpueue doctor\`" >&2
        return 0
    else
        version=$(timeout 10 "$criu" --version 2>/dev/null |
            sed -n 's/^Version:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' | head -n 1) || true
        # Not parsable: an unusual build, which the helper assumes is new enough.
        [ -n "$version" ] || return 0
        major=${version%%.*}
        minor=${version#"$major"}
        minor=${minor#.}
        minor=${minor%%.*}
        if [ "$major" -gt 4 ] || { [ "$major" -eq 4 ] && [ "${minor:-0}" -ge 2 ]; }; then
            return 0
        fi
        found="found $version at $criu"
    fi
    echo "gpueue: warning: CRIU 4.2 or newer is needed to checkpoint ($found)." >&2
    echo "gpueue: jobs run, but checkpoints are refused until it is installed; see \`gpueue doctor\` and https://github.com/kaito4681/gpueue/blob/main/docs/install.md#criu" >&2
}

case "$1" in
configure)
    if [ -z "$2" ] || [ -e "$REMOVED_MARKER" ]; then
        action=install
    else
        action=upgrade
    fi
    ;;
abort-remove | abort-deconfigure)
    # The removal was rolled back after prerm ran: if it already stopped and
    # disabled the services (it then left the marker), bring them back.
    if [ -e "$REMOVED_MARKER" ]; then
        action=install
    else
        exit 0
    fi
    ;;
1) action=install ;;
2) action=upgrade ;;
# abort-upgrade: prerm `upgrade` changed nothing; the old version stays as it was.
*) exit 0 ;;
esac

# The system user `gpueue` and the group `gpueue-admin` (sysusers.d/gpueue.conf;
# systemd-sysusers comes with the systemd the package depends on).
systemd-sysusers /usr/lib/sysusers.d/gpueue.conf

# /var/lib/gpueue and /run/gpueue (tmpfiles.d/gpueue.conf).
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/gpueue.conf ||
        echo "gpueue: warning: systemd-tmpfiles --create failed; the services create what they need at boot" >&2
else
    echo "gpueue: warning: systemd-tmpfiles not found; /var/lib/gpueue and /run/gpueue were not created" >&2
fi

if systemd_running; then
    systemctl daemon-reload || true
fi

if [ "$action" = install ]; then
    rm -f "$REMOVED_MARKER"
    if systemd_running; then
        systemctl enable $UNITS ||
            echo "gpueue: warning: could not enable $UNITS" >&2
        if systemctl start $UNITS; then
            echo "gpueue: started $UNITS. Check the installation with \`gpueue doctor\`."
        else
            echo "gpueue: warning: $UNITS did not start; see \`gpueue doctor\` and \`journalctl -u gpueue-helper -u gpueue\`" >&2
        fi
    else
        # Offline: only the [Install] symlinks, so the services start on the next boot.
        systemctl --no-reload enable $UNITS >/dev/null 2>&1 || true
        echo "gpueue: systemd is not running; the services were not started."
    fi
else
    if systemd_running; then
        # Only the services that are running (an administrator may have stopped them).
        systemctl try-restart $UNITS ||
            echo "gpueue: warning: restarting $UNITS failed; see \`gpueue doctor\`" >&2
    fi
fi

check_criu || true

exit 0
